name: Matrix Build Sultan + xxKSU + SUSFS Full

on:
  workflow_dispatch:

permissions:
  contents: write
  actions: write

concurrency:
  group: sultan-matrix-release
  cancel-in-progress: false

env:
  ANYKERNEL_REPO: https://github.com/TheWildJames/AnyKernel3.git
  PATCHES_REPO: https://github.com/yapixel/kernel_patches
  BUILD_PATCHES_REPO: https://github.com/yapixel/cheetah_kernel_build
  SUSFS_REPO_URL: https://gitlab.com/simonpunk/susfs4ksu
  SUSFS_REPO_BRANCH: gki-android14-6.1
  SCRIPTS_REPO: https://github.com/TheSillyOk/sh

  KSU_REPO: backslashxx/KernelSU
  KSU_BRANCH: master

  GCC_VERSION: "14.2.rel1"

  SULTAN_TAG: "20260314"

  KERNEL_REPO: https://github.com/kerneltoast/android_kernel_google_tensynos
  KERNEL_BRANCH: 16.0.0-sultan

jobs:
  build:
    name: Build ${{ matrix.codename }} Kernel
    runs-on: ubuntu-latest
    
    outputs:
      ksu_ver: ${{ steps.meta.outputs.ksu_ver }}
      s_tag: ${{ steps.meta.outputs.s_tag }}
      susfs_ver: ${{ steps.meta.outputs.susfs_ver }}

    strategy:
      fail-fast: false
      matrix:
        include:
          - codename: gs201
            device_label: Pixel 7
            defconfig: gs201_defconfig
            anykernel_branch: sultan-gs201
            dtb_path: google-devices/gs201/dts

          - codename: zuma
            device_label: Pixel 8
            defconfig: zuma_defconfig
            anykernel_branch: sultan-zuma
            dtb_path: google-devices/zuma/dts

    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            bc bison build-essential cpio flex git kmod libelf-dev libssl-dev \
            lz4 pahole python3 rsync unzip wget zip

      - name: Install GCC
        run: |
          BASE_URL="https://developer.arm.com/-/media/Files/downloads/gnu/${{ env.GCC_VERSION }}/binrel/"
          ARCHIVE="arm-gnu-toolchain-${{ env.GCC_VERSION }}-x86_64-aarch64-none-linux-gnu.tar.xz"

          wget -q "${BASE_URL}/${ARCHIVE}" -O gcc.tar.xz
          tar -xf gcc.tar.xz

          echo "GCC_PATH=$GITHUB_WORKSPACE/arm-gnu-toolchain-${{ env.GCC_VERSION }}-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-" >> "$GITHUB_ENV"

      - name: Clone Source
        run: |
          git clone "${{ env.KERNEL_REPO }}" -b "${{ env.KERNEL_BRANCH }}" sultan

          cd sultan
          git fetch --tags
          git checkout "tags/${{ env.SULTAN_TAG }}" -b "build-${{ env.SULTAN_TAG }}-${{ matrix.codename }}"
          cd ..

          git clone --depth=1 "${{ env.ANYKERNEL_REPO }}" -b "${{ matrix.anykernel_branch }}" AK3
          git clone --depth=1 "${{ env.PATCHES_REPO }}" kernel_patches
          git clone --depth=1 "${{ env.BUILD_PATCHES_REPO }}" cheetah_kernel_build
          git clone --depth=1 "${{ env.SCRIPTS_REPO }}" sh
          git clone --depth=1 --branch="${{ env.SUSFS_REPO_BRANCH }}" "${{ env.SUSFS_REPO_URL }}" susfs4ksu

      - name: Metadata
        id: meta
        run: |
          set -euo pipefail
          S_TAG="${{ env.SULTAN_TAG }}"

          if ! git -C sultan tag | grep -q "^${S_TAG}$"; then
            echo "::error::Sultan tag '${S_TAG}' not found!"
            echo "Available tags:"
            git -C sultan tag | tail -20
            exit 1
          fi

          K_VER=$(bash ./sh/get_ksuver.sh "backslashxx" "KernelSU" "${{ env.KSU_BRANCH }}" || echo "unknown")
          
          SUSFS_PATH="susfs4ksu/kernel_patches/include/linux/susfs.h"
          if [ -f "$SUSFS_PATH" ]; then
            SUSFS_VER=$(grep -E '#define SUSFS_VERSION' "$SUSFS_PATH" | awk -F '"' '{print $2}')
          fi
          SUSFS_VER=${SUSFS_VER:-"unknown"}

          echo "ksu_ver=$K_VER" >> "$GITHUB_OUTPUT"
          echo "s_tag=$S_TAG" >> "$GITHUB_OUTPUT"
          echo "susfs_ver=$SUSFS_VER" >> "$GITHUB_OUTPUT"

          echo "Device: ${{ matrix.codename }}"
          echo "Sultan tag: $S_TAG"
          echo "xxKSU version: r$K_VER"
          echo "SuSFS Version: $SUSFS_VER"

      - name: KSU & Patches
        working-directory: sultan
        run: |
          curl -LSs "https://raw.githubusercontent.com/${{ env.KSU_REPO }}/${{ env.KSU_BRANCH }}/kernel/setup.sh" | bash -s -- "${{ env.KSU_BRANCH }}"

          patch -p1 < ../kernel_patches/sultan/60_scripts_mkcompile_h.patch
          patch -p1 < ../kernel_patches/sultan/61_scripts_setlocalversion.patch
          patch -p1 < ../kernel_patches/sultan/62_init_Makefile.patch

      - name: Apply Patches KSU + SuSFS (10+50 Logic)
        working-directory: sultan
        run: |
          cp ../susfs4ksu/kernel_patches/fs/susfs.c fs/
          cp ../susfs4ksu/kernel_patches/include/linux/susfs.h include/linux/
          cp ../susfs4ksu/kernel_patches/include/linux/susfs_def.h include/linux/
          patch -p1 < "${{ github.workspace }}/cheetah_kernel_build/.github/patches/xxksu/51_deinlined_susfs_hooks_sultan-android14-6.1.patch" || true
          
          #patch -p1 < ../kernel_patches/sultan/sys.c_fix.patch ||true
          
          cd KernelSU
          patch -p1 -l --fuzz=3 < "${{ github.workspace }}/cheetah_kernel_build/.github/patches/xxksu/11_enable_susfs_for_ksu.patch"

      - name: Global Defconfig Analysis
        working-directory: sultan
        run: |
          echo "=== Scanning Defconfig for ${{ matrix.codename }} ==="

          CONF_PATH="arch/arm64/configs/${{ matrix.defconfig }}"

          CHECK_FLAGS=(
            CONFIG_NETFILTER_ADVANCED
            CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
            CONFIG_KSU
            CONFIG_TCP_CONG_BBR
            CONFIG_IP_SET
            CONFIG_KSU_SUSFS
          )

          for flag in "${CHECK_FLAGS[@]}"; do
            grep "$flag" "$CONF_PATH" || echo "  - $flag: missing"
          done

      - name: Inject Configuration
        working-directory: sultan
        env:
          CROSS_COMPILE: ${{ env.GCC_PATH }}
          CC: ${{ env.GCC_PATH }}gcc
        run: |
          make O=out CROSS_COMPILE="$CROSS_COMPILE" CC="$CC" ${{ matrix.defconfig }}

          cat >> out/.config << 'EOF'
          CONFIG_TMPFS_XATTR=y
          CONFIG_TMPFS_POSIX_ACL=y
          CONFIG_LOG_BUF_SHIFT=21
          CONFIG_NETFILTER_ADVANCED=y
          CONFIG_IP_NF_TARGET_TTL=y
          CONFIG_IP6_NF_TARGET_HL=y
          CONFIG_IP6_NF_MATCH_HL=y
          CONFIG_BPF_STREAM_PARSER=y
          CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
          CONFIG_NETFILTER_XT_TARGET_TPROXY=y
          CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
          CONFIG_NETFILTER_XT_MATCH_SOCKET=y
          CONFIG_NETFILTER_XT_MATCH_MARK=y
          CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
          CONFIG_NETFILTER_XT_MATCH_OWNER=y
          CONFIG_NETFILTER_XT_MATCH_MAC=y
          CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
          CONFIG_NETFILTER_XT_MARK=y
          CONFIG_NETFILTER_XT_CONNMARK=y
          CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
          CONFIG_NETFILTER_XT_SET=y
          CONFIG_IP6_NF_NAT=y
          CONFIG_IP6_NF_TARGET_REDIRECT=y
          CONFIG_IP6_NF_TARGET_MASQUERADE=y
          CONFIG_IP_MULTIPLE_TABLES=y
          CONFIG_IPV6_MULTIPLE_TABLES=y
          CONFIG_XFRM_ALGO=y
          CONFIG_INET_IPCOMP=y
          CONFIG_INET_XFRM_TUNNEL=y
          CONFIG_INET_ESP=y
          CONFIG_XFRM_USER=y
          CONFIG_XFRM_SUB_POLICY=y
          CONFIG_INET_XFRM_MODE_TUNNEL=y
          CONFIG_XFRM_STATISTICS=y
          CONFIG_IP_SET=y
          CONFIG_IP_SET_MAX=65534
          CONFIG_IP_SET_BITMAP_IP=y
          CONFIG_IP_SET_BITMAP_IPMAC=y
          CONFIG_IP_SET_BITMAP_PORT=y
          CONFIG_IP_SET_HASH_IP=y
          CONFIG_IP_SET_HASH_IPMARK=y
          CONFIG_IP_SET_HASH_IPPORT=y
          CONFIG_IP_SET_HASH_IPPORTIP=y
          CONFIG_IP_SET_HASH_IPPORTNET=y
          CONFIG_IP_SET_HASH_IPMAC=y
          CONFIG_IP_SET_HASH_MAC=y
          CONFIG_IP_SET_HASH_NETPORTNET=y
          CONFIG_IP_SET_HASH_NET=y
          CONFIG_IP_SET_HASH_NETNET=y
          CONFIG_IP_SET_HASH_NETPORT=y
          CONFIG_IP_SET_HASH_NETIFACE=y
          CONFIG_IP_SET_LIST_SET=y
          CONFIG_TCP_CONG_ADVANCED=y
          CONFIG_TCP_CONG_BBR=y
          CONFIG_NET_SCH_FQ=y
          # CONFIG_TCP_CONG_BIC is not set
          # CONFIG_TCP_CONG_WESTWOOD is not set
          # CONFIG_TCP_CONG_HTCP is not set
          CONFIG_DEFAULT_BBR=y
          CONFIG_DEFAULT_TCP_CONG="bbr"
          CONFIG_KSU=y
          CONFIG_KSU_EXTRAS=y
          # CONFIG_KSU_ALLOWLIST_WORKAROUND is not set
          # CONFIG_KSU_DEBUG is not set
          # CONFIG_KSU_KPROBES_HOOK is not set
          CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
          CONFIG_KSU_LSM_SECURITY_HOOKS=y
          CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=y
          CONFIG_SECURITY_NETWORK=y
          CONFIG_CGROUPS=y
          CONFIG_CGROUP_BPF=y
          CONFIG_CGROUP_SCHED=y
          CONFIG_CGROUP_PIDS=y
          CONFIG_CGROUP_FREEZER=y
          CONFIG_INOTIFY_USER=y
          CONFIG_KSU_SUSFS=y
          CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
          CONFIG_KSU_SUSFS_SUS_PATH=y
          CONFIG_KSU_SUSFS_SUS_MOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
          CONFIG_KSU_SUSFS_SUS_KSTAT=y
          CONFIG_KSU_SUSFS_TRY_UMOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
          CONFIG_KSU_SUSFS_SPOOF_UNAME=y
          CONFIG_KSU_SUSFS_ENABLE_LOG=y
          CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
          CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
          CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
          CONFIG_KSU_SUSFS_SUS_MAP=y
          CONFIG_NOMOUNT=y
          EOF

          make O=out CROSS_COMPILE="$CROSS_COMPILE" CC="$CC" olddefconfig 2>&1 | grep -v "warning: override" || true

      - name: Build Kernel
        working-directory: sultan
        env:
          KBUILD_BUILD_USER: build-user
          KBUILD_BUILD_HOST: build-host
          CROSS_COMPILE: ${{ env.GCC_PATH }}
          CC: ${{ env.GCC_PATH }}gcc
        run: |
          make O=out CROSS_COMPILE="$CROSS_COMPILE" CC="$CC" -j"$(nproc --all)"

      - name: Package
        run: |
          set -euo pipefail

          IMAGE="sultan/out/arch/arm64/boot/Image.lz4"
          DTB_DIR="sultan/out/${{ matrix.dtb_path }}"

          if [ ! -f "$IMAGE" ]; then
            echo "::error::Image.lz4 not found at $IMAGE"
            find sultan/out -name "Image*" -o -name "*.dtb"
            exit 1
          fi

          if ! ls "$DTB_DIR"/*.dtb >/dev/null 2>&1; then
            echo "::error::No DTB files found in $DTB_DIR"
            find sultan/out -name "*.dtb"
            exit 1
          fi

          cp "$IMAGE" AK3/Image.lz4
          cat "$DTB_DIR"/*.dtb > AK3/dtb

          CLEAN_S_TAG=$(printf '%s' "${{ steps.meta.outputs.s_tag }}" | sed 's/[^A-Za-z0-9._-]/_/g')
          ZIP_NAME="Sultan-${{ matrix.codename }}-${CLEAN_S_TAG}-xxKSU-SUSFS-${{ steps.meta.outputs.susfs_ver }}+${{ steps.meta.outputs.ksu_ver }}.zip"

          (
            cd AK3
            zip -r9 "../$ZIP_NAME" . -x "*.git*" "README.md"
          )

          mkdir -p out_zip
          mv "$ZIP_NAME" out_zip/

      - name: Upload
        uses: actions/upload-artifact@v7
        with:
          name: Sultan-${{ matrix.codename }}
          path: out_zip/*.zip

  release:
    name: Create GitHub Release
    needs: build
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - uses: actions/download-artifact@v8
        with:
          path: ./artifacts
          merge-multiple: true

      - name: List artifacts debug
        run: |
          echo "=== artifacts directory contents ==="
          ls -la ./artifacts/

          echo "=== find zip files ==="
          find ./artifacts -name "*.zip" -type f

      - name: Tag and Release
        env:
          GH_TOKEN: ${{ github.token }}
          KSU_VER: ${{ needs.build.outputs.ksu_ver }}
          S_TAG: ${{ needs.build.outputs.s_tag }}
          SUSFS_VER: ${{ needs.build.outputs.susfs_ver }}
        run: |
          set -euo pipefail
          DATE=$(date +"%Y.%m.%d")
          MAX_REV=$(git tag -l "${DATE}-r*" | sed "s/${DATE}-r//" | sort -n | tail -n1)
          REV=$(( ${MAX_REV:-0} + 1 ))
          TAG="${DATE}-r${REV}"

          git config user.name "github-actions"
          git config user.email "actions@github.com"

          git tag "$TAG"
          git push origin "$TAG"

          mapfile -t ZIP_FILES < <(find ./artifacts -name "*.zip" -type f | sort)

          if [ "${#ZIP_FILES[@]}" -eq 0 ]; then
            echo "No zip files found!"
            exit 1
          fi

          echo "Found zip files:"
          printf '%s\n' "${ZIP_FILES[@]}"

          cat > release_notes.md <<EOF
          ### 🚀 Build Information

          | Component | Details |
          | :--- | :--- |
          | **Devices** | gs201, zuma |
          | **Kernel Base** | Sultan ($S_TAG) |
          | **Manager** | [backslashxx/KernelSU](https://github.com/backslashxx/KernelSU) |
          | **KowSU Ver** | \`$KSU_VER\` |
          | **SuSFS Ver** | \`$SUSFS_VER\` |
          | **Compiler** | GCC ${{ env.GCC_VERSION }} |
          | **SuSFS Branch** | \`sultan-shiba-susfs-minimal\` |

          ### 🛠️ Networking Features (Fortress)

          - **TCP Congestion:** BBR (v1) + FQ
          - **Routing:** Policy Routing (Table 1066) + IPSet (64k)
          - **Fixes:** ADDRTYPE Match, Google VPN (XFRM), TTL 64 Share
          - **Root:** xxKSU + SuSFS LSM / hookless configuration

          > Built automatically with GitHub Actions matrix.
          EOF

          gh release create "$TAG" "${ZIP_FILES[@]}" \
            --title "Kernel Build — $TAG" \
            --notes-file release_notes.md
